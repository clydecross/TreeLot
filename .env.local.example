# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Supabase Postgres. Two URLs because PgBouncer (the connection pooler)
# can't handle the prepared statements that database migrations rely on.
#
# DATABASE_URL  — pooled connection (port 6543). Used at runtime by the
#                 app for normal queries. Fast, shared, scales to many
#                 short-lived Vercel function invocations.
# DIRECT_URL    — direct connection (port 5432). Used by `prisma migrate`
#                 for schema changes. Slower, one-at-a-time, but supports
#                 the full Postgres protocol.
#
# Both are in the Supabase dashboard under Project Settings → Database →
# Connection string. Replace [YOUR-PASSWORD] with the database password
# you set when creating the project.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# Clerk (auth) — get from clerk.com dashboard
# ─────────────────────────────────────────────
# Server-side secret key
CLERK_SECRET_KEY=sk_test_
# Client-side publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Clerk redirect URLs. After sign-in/up we always land on /onboarding so the
# org-creation / invite-acceptance flow can run before pushing into /pos.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Full public URL of the deployed app (no trailing slash). Used by Clerk
# invitation redirects in admin.inviteUser. MUST be set in production —
# otherwise team invitation emails will link to localhost.
NEXT_PUBLIC_APP_URL=https://treelot.vercel.app

# ─────────────────────────────────────────────
# Sentry (error monitoring) — optional
# ─────────────────────────────────────────────
# Omit both DSNs to disable Sentry entirely (init becomes a no-op).
# Same value for both — server reads SENTRY_DSN, browser reads the public one.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Required ONLY for source-map upload during build. Leave unset to skip.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────
# PostHog (product analytics) — optional
# ─────────────────────────────────────────────
# Omit NEXT_PUBLIC_POSTHOG_KEY to disable PostHog (init becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=
# Use https://us.i.posthog.com (default) or https://eu.i.posthog.com depending
# on which region your PostHog project lives in.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────
# TaxJar (US sales tax lookup) — optional
# ─────────────────────────────────────────────
# Used during onboarding to auto-fill the org's sales tax rate based on
# the lot's location address. If unset, the tax rate field falls back to
# manual entry (no auto-fill, no error).
# Get a key at https://app.taxjar.com/api_sign_up — free tier is 10k calls/mo.
TAXJAR_API_KEY=
