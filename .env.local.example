# ─────────────────────────────────────────────
# Environment topology (Decision 2 in treelot-architect-preferences.md)
# ─────────────────────────────────────────────
# Two-environment split:
#
#   • LOCAL (.env.local) + Vercel PREVIEW   →  treelot-dev Supabase project
#   • Vercel PRODUCTION                     →  treelot-prod Supabase project
#
# This file documents the LOCAL values. On Vercel, set Production-scoped
# values to the treelot-prod project's URLs/keys; set Preview-scoped values
# to match the treelot-dev project (mirrors local).
#
# A handful of variables MUST differ between environments — they're flagged
# below with a "PER-ENV" note.

# ─────────────────────────────────────────────
# Database  (PER-ENV — different Supabase project for prod)
# ─────────────────────────────────────────────
# Supabase Postgres. Two URLs because PgBouncer (the connection pooler)
# can't handle the prepared statements that database migrations rely on.
#
# DATABASE_URL  — pooled connection (port 6543). Used at runtime by the
#                 app for normal queries.
# DIRECT_URL    — direct connection (port 5432). Used by `prisma migrate`
#                 for schema changes.
#
# Both are in Supabase → Project Settings → Database → Connection string.
# Replace [YOUR-PASSWORD] with the database password you set at project
# creation. Local + Preview use the treelot-dev project; Production uses
# treelot-prod.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# Clerk (auth) — get from clerk.com dashboard
# (PER-ENV — separate Clerk Production application for prod)
# ─────────────────────────────────────────────
# Local + Preview use a Clerk Test instance (sk_test_… / pk_test_…).
# Production uses a separate Clerk app on its Production instance
# (sk_live_… / pk_live_…).
#
# Server-side secret key
CLERK_SECRET_KEY=sk_test_
# Client-side publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Clerk redirect URLs. After sign-in/up we always land on /onboarding so the
# org-creation / invite-acceptance flow can run before pushing into /pos.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Full public URL of the deployed app (no trailing slash). Used by Clerk
# invitation redirects in admin.inviteUser. MUST be set in production —
# otherwise team invitation emails will link to localhost.
NEXT_PUBLIC_APP_URL=https://treelot.vercel.app

# ─────────────────────────────────────────────
# Sentry (error monitoring) — optional
# ─────────────────────────────────────────────
# Omit both DSNs to disable Sentry entirely (init becomes a no-op).
# Same value for both — server reads SENTRY_DSN, browser reads the public one.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Required ONLY for source-map upload during build. Leave unset to skip.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────
# PostHog (product analytics) — optional
# ─────────────────────────────────────────────
# Omit NEXT_PUBLIC_POSTHOG_KEY to disable PostHog (init becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=
# Use https://us.i.posthog.com (default) or https://eu.i.posthog.com depending
# on which region your PostHog project lives in.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────
# Driver session signing key (REQUIRED)
# (PER-ENV — generate a SEPARATE secret for production)
# ─────────────────────────────────────────────
# HMAC secret used to sign the HttpOnly cookie that authenticates a driver
# after PIN login. Must be 32+ chars. Generate with:
#   openssl rand -base64 48
# Rotating this key invalidates every active driver session — on purpose.
#
# Generate ONE secret for local + Preview, and a SEPARATE one for prod
# (set only in Vercel's Production scope, never in .env.local). That way
# a leak of the dev secret can't be used to forge prod driver sessions.
DRIVER_SESSION_SECRET=

# ─────────────────────────────────────────────
# TaxJar (US sales tax lookup) — optional
# ─────────────────────────────────────────────
# Used during onboarding to auto-fill the org's sales tax rate based on
# the lot's location address. If unset, the tax rate field falls back to
# manual entry (no auto-fill, no error).
# Get a key at https://app.taxjar.com/api_sign_up — free tier is 10k calls/mo.
TAXJAR_API_KEY=

# ─────────────────────────────────────────────
# Inngest (background jobs) — Decision 3
# (PER-ENV — separate keys for treelot-dev vs treelot-prod environment)
# ─────────────────────────────────────────────
# Inngest runs scheduled and event-driven background work (emails, SMS,
# geocoding, audit batching, etc.) so the request thread never blocks.
#
# Get keys at https://app.inngest.com → your "treelot" app:
#   • EVENT_KEY     — used by our app to send events to Inngest
#   • SIGNING_KEY   — used by Inngest Cloud to authenticate calls back to
#                     /api/inngest. The serve handler verifies this; without
#                     it, prod requests are rejected.
#
# Local dev: optional — `npm run dev:inngest` starts a local Inngest dev
# server that doesn't require either key. Setting them locally lets you
# test the "real" cloud path before deploying.
#
# Vercel: set Preview-scoped values from the Branch/Development environment;
# set Production-scoped values from the Production environment. Mixing them
# is the most common foot-gun.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Tells the Inngest SDK we're in local dev mode (no signing-key check, talks
# to the local dev server at :8288). Required for `npm run dev:inngest`.
# Leave UNSET in Vercel — production should hit Inngest Cloud with real keys.
INNGEST_DEV=1
