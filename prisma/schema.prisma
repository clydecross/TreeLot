generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Plan {
  starter
  pro
  enterprise
}

enum Role {
  owner
  manager
  staff
  driver
}

enum PaymentMethod {
  cash
  card
  venmo
  zelle
}

enum TimeWindow {
  morning
  afternoon
  evening
  anytime
}

enum DeliveryStatus {
  unassigned
  scheduled
  out_for_delivery
  delivered
  failed
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  plan             Plan     @default(starter)
  stripeCustomerId String?
  taxRateBps       Int      @default(825)
  createdAt        DateTime @default(now()) @db.Timestamptz

  locations   Location[]
  users       User[]
  customers   Customer[]
  invitations Invitation[]

  @@map("organizations")
}

model Location {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  address   String
  timezone  String   @default("America/Chicago")
  createdAt DateTime @default(now()) @db.Timestamptz

  org         Organization @relation(fields: [orgId], references: [id])
  users       User[]
  purchases   Purchase[]
  deliveries  Delivery[]
  invitations Invitation[]

  @@map("locations")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId    String   @unique
  orgId      String   @db.Uuid
  locationId String?  @db.Uuid
  role       Role
  name       String
  email      String
  phone      String?
  pin        String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  org      Organization @relation(fields: [orgId], references: [id])
  location Location?    @relation(fields: [locationId], references: [id])
  purchases   Purchase[]
  deliveries  Delivery[]
  invitations Invitation[] @relation("InvitedBy")
  pinFailure  PinFailure?
  authAudits  AuthAuditLog[]

  @@map("users")
}

model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @db.Uuid
  firstName    String
  lastName     String
  phone        String
  email        String?
  addressLine1 String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  org        Organization @relation(fields: [orgId], references: [id])
  purchases  Purchase[]
  deliveries Delivery[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Purchase {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String        @db.Uuid
  locationId      String        @db.Uuid
  createdById     String        @db.Uuid
  seasonYear      Int
  treeType        String
  treeTypeName    String?
  treeSizeRange   String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  paymentMethod   PaymentMethod
  standIncluded   Boolean       @default(false)
  lightsIncluded  Boolean       @default(false)
  deliveryRequested Boolean     @default(false)
  notes           String?
  purchasedAt     DateTime      @db.Timestamptz

  customer   Customer @relation(fields: [customerId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
  createdBy  User     @relation(fields: [createdById], references: [id])
  delivery   Delivery?

  @@map("purchases")
}

model Delivery {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId          String         @unique @db.Uuid
  customerId          String         @db.Uuid
  locationId          String         @db.Uuid
  driverId            String?        @db.Uuid
  addressLine1        String
  city                String
  state               String
  zip                 String
  lat                 Decimal?       @db.Decimal(9, 6)
  lng                 Decimal?       @db.Decimal(9, 6)
  deliveryDate        DateTime       @db.Date
  timeWindow          TimeWindow
  standIncluded       Boolean
  lightsIncluded      Boolean
  installRequested    Boolean        @default(false)
  routeOrder          Int?
  status              DeliveryStatus @default(unassigned)
  specialInstructions String?
  driverNotes         String?
  issueReason         String?
  deliveredAt         DateTime?      @db.Timestamptz
  createdAt           DateTime       @default(now()) @db.Timestamptz
  updatedAt           DateTime       @updatedAt @db.Timestamptz

  purchase Purchase  @relation(fields: [purchaseId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  driver   User?     @relation(fields: [driverId], references: [id])

  @@map("deliveries")
}

// Per-user PIN lockout state. One row per User the moment we see a failed PIN
// attempt; updated atomically. `lockedUntil` is a hard floor — any
// authenticate() call before that time is rejected without checking the PIN.
model PinFailure {
  userId         String    @id @db.Uuid
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz
  lastAttemptAt  DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pin_failures")
}

// Append-only audit trail for credential events. Today: PIN auth attempts
// (authenticate, changePin) and the public driver-list lookup. Read by the
// IP-rate-limit gate (count rows per ip+scope in a sliding window).
//
// userId is nullable: an attempt against a non-existent userId still gets a
// row so brute-force enumeration is visible in the log.
model AuthAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      String   // e.g. "driver.authenticate", "driver.changePin", "driver.getList"
  userId     String?  @db.Uuid
  locationId String?  @db.Uuid
  ip         String?
  userAgent  String?
  success    Boolean
  reason     String?  // short tag for failure cases ("locked", "rate_limited", "bad_pin", "no_user")
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ip, scope, createdAt])
  @@index([userId, createdAt])
  @@map("auth_audit_log")
}

model Invitation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String           @db.Uuid
  email         String
  role          Role
  locationId    String?          @db.Uuid
  invitedById   String           @db.Uuid
  clerkInviteId String?          @unique
  status        InvitationStatus @default(pending)
  acceptedAt    DateTime?        @db.Timestamptz
  createdAt     DateTime         @default(now()) @db.Timestamptz

  org       Organization @relation(fields: [orgId], references: [id])
  location  Location?    @relation(fields: [locationId], references: [id])
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([orgId, status])
  @@map("invitations")
}
